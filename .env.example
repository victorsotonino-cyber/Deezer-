DISCORD_TOKEN=PEGA_AQUI_EL_TOKEN_PRIVADO
CLIENT_ID=ID_DE_LA_APLICACION_DISCORD
# Opcional: ID del servidor para que los comandos aparezcan inmediatamente
GUILD_ID=
BOT_NAME=DATASHOP
PREFIX=!
EMBED_COLOR=7C3AED
# Opcional: autorol fijo; también se configura con /configuracion autorol
MEMBER_ROLE_ID=
# IDs de propietarios separados por comas
OWNER_IDS=
# En Render utiliza /var/data/datashop.sqlite con disco persistente
DB_PATH=./data/datashop.sqlite
PORT=3000
